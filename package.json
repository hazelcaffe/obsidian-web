{
	"name": "obsidian-web",
	"version": "0.1.0",
	"private": true,
	"description": "Run the Obsidian desktop app in the browser, with vaults stored in OPFS and networking over libcurl.js/Wisp",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"watch": "node scripts/build.ts --watch",
		"start": "node src/server/main.ts",
		"dev": "node scripts/build.ts && node src/server/main.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p src/sw/tsconfig.json && tsc -p tsconfig.node.json",
		"test": "node --test \"test/**/*.test.ts\"",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"test:e2e": "node --test \"test/e2e/*.e2e.ts\""
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@types/node": "^24.19.2",
		"assert": "^2.1.0",
		"browserify-zlib": "^0.2.0",
		"buffer": "^6.0.3",
		"esbuild": "^0.28.2",
		"events": "^3.3.0",
		"fflate": "^0.8.3",
		"libcurl.js": "^0.7.5",
		"path-browserify": "^1.0.1",
		"playwright-core": "1.65.1",
		"querystring-es3": "^0.2.1",
		"readable-stream": "^4.8.0",
		"string_decoder": "^1.3.0",
		"typescript": "^7.0.2",
		"util": "^0.12.5"
	},
	"dependencies": {
		"@mercuryworkshop/wisp-js": "^0.5.3"
	}
}
